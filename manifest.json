{
  "version": 2,
  "name": "agent-kit",
  "description": "Codex 全局环境清单：自建的用代码装，第三方交给 agent 按官方文档装。三端通用。",
  "target": "codex",

  "targets": {
    "codex": {
      "root": "~/.codex",
      "skills": "~/.codex/skills"
    }
  },

  "apply": [
    {
      "id": "bug-debugging",
      "kind": "skill",
      "from": "skills/bug-debugging",
      "targets": ["codex"],
      "note": "自己写的：证据驱动的调试流程"
    },
    {
      "id": "context7-mcp",
      "kind": "skill",
      "from": "skills/context7-mcp",
      "targets": ["codex"],
      "note": "自己写的：教 agent 怎么用 context7 查库文档"
    },
    {
      "id": "tapd-workbench",
      "kind": "skill",
      "from": "skills/tapd-workbench",
      "targets": ["codex"],
      "note": "自己写的：TAPD 工作项查询"
    },
    {
      "id": "codex-AGENTS.md",
      "kind": "file",
      "from": "config/codex-AGENTS.md",
      "to": "~/.codex/AGENTS.md",
      "note": "全局指令。覆盖前备份。"
    }
  ],

  "agentTasks": [
    {
      "id": "design-taste-frontend",
      "kind": "skill",
      "source": "https://github.com/Leonxlnx/taste-skill",
      "docs": "https://github.com/Leonxlnx/taste-skill",
      "targets": ["codex"],
      "follow": "latest",
      "hint": "前端设计品味 skill，带 library/ 和 references/ 大目录（约 2.4MB）。装到 ~/.codex/skills/design-taste-frontend。"
    },
    {
      "id": "context7-mcp",
      "kind": "mcp",
      "docs": "https://github.com/upstash/context7#installation",
      "needs": ["CONTEXT7_API_KEY"],
      "targets": ["codex"],
      "hint": "HTTP 型。优先用 `codex mcp add context7 --url https://mcp.context7.com/mcp --header \"Authorization: Bearer $KEY\"`；没有 codex CLI 就写进 ~/.codex/config.toml 的 [mcp_servers.context7]。key 由用户自己取，不要复用别的机器的。"
    },
    {
      "id": "playwright-mcp",
      "kind": "mcp",
      "docs": "https://github.com/microsoft/playwright-mcp",
      "targets": ["codex"],
      "hint": "stdio 型，npx -y @playwright/mcp@latest。注意：Windows 上用 cmd /c 包裹，mac/linux 直接 npx。首次运行可能下载浏览器内核。"
    },
    {
      "id": "codegraph-mcp",
      "kind": "mcp",
      "docs": "https://www.npmjs.com/package/@colbymchenry/codegraph",
      "targets": ["codex"],
      "hint": "stdio 型。先全局装 @colbymchenry/codegraph，再 codegraph serve --mcp。"
    }
  ],

  "tokens": [
    {
      "key": "CONTEXT7_API_KEY",
      "usedBy": "context7-mcp",
      "howToGet": "https://context7.com/dashboard",
      "envFile": "~/.agent-kit.env"
    }
  ],

  "notForCodex": [
    { "id": "frontend-design", "source": "https://github.com/anthropics/skills", "why": "之前装在 ~/.agents，Codex 用不到" },
    { "id": "mattpocock-skills", "source": "https://github.com/mattpocock/skills", "why": "7 个 skill，之前装在 ~/.agents，Codex 没装。要的话在 agentTasks 里加一条" }
  ],

  "machineSpecific": [
    "config.toml 里的 model / model_provider / notify / projects / node_repl 都带本机绝对路径，不进仓库",
    "~/.codex/rules/default.rules 是会话自动生成的审批记录，不进仓库",
    "~/.codex/auth.json 是登录态，不进仓库"
  ]
}
